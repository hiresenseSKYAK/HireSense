DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Comma-separated frontend origins. Keep localhost for local development.
CORS_ORIGINS=http://localhost:5173

# Local Hugging Face summarization for job descriptions (no API key needed).
# Model downloads automatically on first crawl (~300MB for the default DistilBART).
# Uses the seq2seq generate() API so it works with transformers 5.x.
SUMMARIZE_JOB_DESCRIPTIONS=true
AI_MODEL=sshleifer/distilbart-cnn-12-6

# Local JobBERT NER for job skills (no API key needed).
# Spans are kept only if they map onto backend/data/skills_catalog.py.
# Downloads two BERT models on first crawl (~400MB total).
EXTRACT_JOB_SKILLS=true
SKILL_MODEL=jjzha/jobbert_skill_extraction
KNOWLEDGE_MODEL=jjzha/jobbert_knowledge_extraction

CRAWLER_SCHEDULE=0 2 * * *
