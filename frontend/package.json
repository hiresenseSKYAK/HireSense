    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}
